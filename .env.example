# ============================================================
# SAMANWAY — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real values
# ============================================================

# CLAUDE API CONFIGURATION
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Which Claude model to use
# Available: claude-opus-5, claude-sonnet-4-6, claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6

# Timeout for Claude API calls (seconds)
CLAUDE_TIMEOUT=60

# ============================================================
# EMBEDDING CONFIGURATION
# ============================================================

# Embedding model for semantic retrieval
# Recommended: bge-m3 (stronger than all-MiniLM-L6-v2)
EMBEDDING_MODEL=bge-m3

# Where to cache downloaded embeddings
EMBEDDING_CACHE_PATH=./embeddings_cache

# ============================================================
# RERANKER CONFIGURATION
# ============================================================

# Cross-encoder model for reranking top candidates
RERANKER_MODEL=bge-reranker-base

# Timeout for reranker (seconds)
RERANKER_TIMEOUT=30

# ============================================================
# CONFIDENCE MODEL
# ============================================================

# Path to trained calibrated confidence model
CONFIDENCE_MODEL_PATH=./models/confidence_model.pkl

# Confidence thresholds (0-1)
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_MEDIUM=0.65

# ============================================================
# FEATURE FLAGS
# ============================================================

# Enable Claude-based extraction (vs. fallback to rules)
ENABLE_CLAUDE_EXTRACTION=true

# Enable engineering knowledge RAG
ENABLE_RAG=true

# Enable cross-encoder reranking
ENABLE_RERANKER=true

# Enable calibrated confidence model
ENABLE_CONFIDENCE_MODEL=true

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# SQLite database for audit logs and approvals
SQLITE_DB_PATH=./data/samanway.db

# DuckDB database path for analytics
DUCKDB_DB_PATH=./data/analytics.db

# ============================================================
# SCHEDULE CONFIGURATION
# ============================================================

# Path to Oil India schedule CSV (L5/L6 activities)
SCHEDULE_CSV_PATH=./data/oil_india_l5l6_schedule.csv

# ============================================================
# LOGGING & DEBUG
# ============================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./logs/samanway.log

# Enable verbose API logging (DEBUG mode)
DEBUG_API_CALLS=false

# ============================================================
# SERVICE PORTS
# ============================================================

# Ingestion service
INGESTION_PORT=8001

# Matching service
MATCHING_PORT=8002

# Writeback service
WRITEBACK_PORT=8003

# Analytics service
ANALYTICS_PORT=8004

# ============================================================
# PERFORMANCE TUNING
# ============================================================

# Maximum candidates to pass to reranker (must rerank efficiently)
MAX_RERANK_CANDIDATES=20

# FAISS search top-K for initial retrieval
FAISS_SEARCH_K=50

# Minimum confidence to auto-approve (for HIGH band)
MIN_AUTO_APPROVE_CONFIDENCE=0.85

# ============================================================
# SECURITY
# ============================================================

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT secret for signed messages (if used)
JWT_SECRET=

# ============================================================
# NOTES
# ============================================================
# - ANTHROPIC_API_KEY is REQUIRED for the system to function
# - Other keys have sensible defaults
# - Do NOT commit this file with real values
# - Database files will be created automatically if they don't exist
# - Embeddings will be cached after first download
# - Models will be downloaded on first use
